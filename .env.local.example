# ---------------------------------------------------------------------------
# NWI Shop — copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://nwishop.com

# --- Supabase ----------------------------------------------------------------
# URL + anon key are safe in the browser. The service role key bypasses RLS and
# must only ever be read from server code (lib/supabase/service.ts).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# NWI Shop plan prices. An unset var means that plan cannot be purchased —
# checkout returns before it ever reaches Stripe.
STRIPE_PRICE_SHOP_STARTER=price_xxx
STRIPE_PRICE_SHOP_PRO=price_xxx
STRIPE_PRICE_SHOP_ELITE=price_xxx
# Foreman AI is a separate $59/mo add-on, not bundled into any tier.
STRIPE_PRICE_SHOP_FOREMAN_AI=price_xxx

# --- Twilio (customer SMS: job status, estimate approvals) -------------------
# Messages route through a hardcoded 10DLC Messaging Service SID in lib/twilio.ts.
# Leave unset to disable SMS — sends are skipped, never fail.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555550100

# --- Email (Resend) ----------------------------------------------------------
# Leave unset to disable email — sends are skipped, never fail.
RESEND_API_KEY=re_xxx

# --- SMTP (legacy / optional fallback mailer) --------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=NWI Shop <no-reply@nwishop.com>

# --- Foreman AI (Anthropic) --------------------------------------------------
# Unset means Foreman AI features render as unavailable rather than erroring.
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Scheduled jobs ----------------------------------------------------------
# Shared secret required by cron route handlers.
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Inherited from the shared NWI environment. NWI Shop does not read any of these
# — they are listed only so a .env.local copied from another NWI product is not
# silently missing keys its other tooling expects. Safe to delete for a
# Shop-only deployment.
# ---------------------------------------------------------------------------
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_FULL_SUITE=
STRIPE_PRICE_FULL_SUITE_PLUS=
STRIPE_PRICE_QUICKWRENCH=
STRIPE_PRICE_DETAILER=
STRIPE_PRICE_FOREMAN=
STRIPE_PRICE_FLEET_PRO=
STRIPE_PRICE_HD_STARTER=
STRIPE_PRICE_HD_PRO=
STRIPE_PRICE_HD_ELITE=
STRIPE_PRICE_HD_REEFER=
GOOGLE_PLACES_API_KEY=
BD_DIRECTORY_AGENT_KEY=
BD_SUBSCRIPTION_ID=
BD_LISTING_LIVE=
BD_HD_DIRECTORY_AGENT_KEY=
BD_HD_SUBSCRIPTION_ID=
BD_HD_BASE_URL=
